<scene version="2.1.0">

<!-- 簡易屋内アパート: 12m x 8m、間仕切り壁で2部屋に分割、ドア開口あり -->
<!-- 材料: 外壁=コンクリート、内壁=石膏ボード、床=コンクリート -->

  <bsdf type="itu-radio-material" id="concrete">
    <string name="type" value="concrete"/>
    <float name="thickness" value="0.2"/>
  </bsdf>
  <bsdf type="itu-radio-material" id="drywall">
    <string name="type" value="plasterboard"/>
    <float name="thickness" value="0.1"/>
  </bsdf>
  <bsdf type="itu-radio-material" id="floor-mat">
    <string name="type" value="concrete"/>
    <float name="thickness" value="0.3"/>
  </bsdf>

  <!-- 床 (12 x 8 m) -->
  <shape type="cube">
    <transform name="to_world">
      <scale x="6.0" y="4.0" z="0.05"/>
      <translate x="0" y="0" z="0"/>
    </transform>
    <ref id="floor-mat" name="bsdf"/>
  </shape>

  <!-- 外壁: 南 (y=-4) / 北 (y=+4) -->
  <shape type="cube">
    <transform name="to_world">
      <scale x="6.0" y="0.1" z="1.5"/>
      <translate x="0" y="-4.0" z="1.5"/>
    </transform>
    <ref id="concrete" name="bsdf"/>
  </shape>
  <shape type="cube">
    <transform name="to_world">
      <scale x="6.0" y="0.1" z="1.5"/>
      <translate x="0" y="4.0" z="1.5"/>
    </transform>
    <ref id="concrete" name="bsdf"/>
  </shape>

  <!-- 外壁: 西 (x=-6) / 東 (x=+6) -->
  <shape type="cube">
    <transform name="to_world">
      <scale x="0.1" y="4.0" z="1.5"/>
      <translate x="-6.0" y="0" z="1.5"/>
    </transform>
    <ref id="concrete" name="bsdf"/>
  </shape>
  <shape type="cube">
    <transform name="to_world">
      <scale x="0.1" y="4.0" z="1.5"/>
      <translate x="6.0" y="0" z="1.5"/>
    </transform>
    <ref id="concrete" name="bsdf"/>
  </shape>

  <!-- 間仕切り壁 (x=0)、ドア開口 (y=2.5..4 を空ける) を2セグメントで -->
  <shape type="cube">
    <transform name="to_world">
      <scale x="0.08" y="3.25" z="1.5"/>
      <translate x="0" y="-0.75" z="1.5"/>
    </transform>
    <ref id="drywall" name="bsdf"/>
  </shape>

</scene>
